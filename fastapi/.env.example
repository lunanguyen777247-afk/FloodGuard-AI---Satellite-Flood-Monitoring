# Application Settings
APP_NAME=FloodGuard-AI
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# API Settings
API_V1_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/floodguard_db

# Google Earth Engine
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=./credentials/gee-private-key.json

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# External Weather APIs
OPENWEATHER_API_KEY=your-openweather-api-key
GPM_API_KEY=your-gpm-api-key

# Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@floodguard-ai.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHANNEL_ID=your-channel-id

# Redis (Caching & Task Queue)
REDIS_URL=redis://localhost:6379/0

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","https://floodguard-ai.com"]

# Security
SECRET_KEY=your-secret-key-min-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Data Processing
MAX_WORKERS=4
CACHE_TTL=3600
DATA_REFRESH_INTERVAL=21600

# File Storage
UPLOAD_DIR=./uploads
REPORTS_DIR=./reports
TILES_CACHE_DIR=./cache/tiles
